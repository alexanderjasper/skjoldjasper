{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SvelteKit Dev (inspect)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/Users/alexander/.nvm/versions/node/v22.16.0/bin/pnpm",
      "runtimeArgs": ["--dir", "apps/web", "dev:inspect"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "FORCE_COLOR": "1"
      },
      "envFile": "${workspaceFolder}/apps/web/.env",
      "preLaunchTask": "Start Database"
    },
    {
      "name": "Game Server (attach)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "restart": true
    },
    {
      "name": "Projector (attach)",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "restart": true
    }
  ],
  "compounds": [
    {
      "name": "All Apps (inspect)",
      "configurations": [
        "SvelteKit Dev (inspect)",
        "Game Server (attach)",
        "Projector (attach)"
      ],
      "stopAll": true
    }
  ]
}

