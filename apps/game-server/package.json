{
  "private": true,
  "name": "game-server",
  "version": "1.0.0",
  "description": "Colyseus game server for skjoldjasper",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "dev": "pnpm start",
    "dev:inspect": "NODE_OPTIONS='--inspect=0.0.0.0:9230' tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "loadtest:quick": "tsx loadtest/example.ts --endpoint ws://localhost:2567 --room my_room --numClients 1 --duration 3",
    "build": "npm run clean && tsc",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.1",
    "@colyseus/testing": "^0.16.3",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.15.6",
    "colyseus.js": "^0.16.22",
    "mocha": "^10.8.2",
    "rimraf": "^5.0.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/playground": "^0.16.4",
    "@colyseus/schema": "^3.0.69",
    "@colyseus/tools": "^0.16.14",
    "@skjoldjasper/db": "workspace:*",
    "@skjoldjasper/shared": "workspace:*",
    "colyseus": "^0.16.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  }
}
