[Unit]
Description=Advertise immich.local on the LAN via mDNS (Avahi)
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
# Long-running: avahi-publish keeps the record alive while it runs.
ExecStart=/usr/local/sbin/immich-mdns.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
