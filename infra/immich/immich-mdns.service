[Unit]
Description=Advertise immich.local on the LAN via mDNS (Avahi)
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service
# Re-publish whenever avahi-daemon restarts; otherwise the CNAME silently
# vanishes (the D-Bus entry group dies with the daemon, not with our process).
PartOf=avahi-daemon.service

[Service]
# Long-running: the publisher blocks to keep its D-Bus entry group alive.
ExecStart=/usr/local/sbin/immich-mdns.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
