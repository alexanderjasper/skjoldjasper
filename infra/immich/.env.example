# Pin to a specific release tag; don't track "release" in production.
IMMICH_VERSION=v3.1.0

# Absolute host paths. These must point at the existing live data so the
# Dokploy-managed stack keeps serving the same photo library.
UPLOAD_LOCATION=/home/alexander/Immich/library
DB_DATA_LOCATION=/home/alexander/Immich/postgres

# Postgres credentials (only used inside the immich compose network).
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich
