# Crontab for pgBackRest backups
# Environment
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
REPO_DIR=$HOME/Code/skjoldjasper

# Weekly FULL backup on Sundays at 02:00
0 2 * * 0 $REPO_DIR/infra/scripts/pgbackrest-backup.sh full >> /tmp/pgbackrest-full.log 2>&1

# Daily DIFF backups Monday–Saturday at 02:00
0 2 * * 1-6 $REPO_DIR/infra/scripts/pgbackrest-backup.sh diff >> /tmp/pgbackrest-diff.log 2>&1


