# Example environment for infra/.env
POSTGRES_USER=app
POSTGRES_PASSWORD=app-password-change-me
POSTGRES_DB=appdb

# Cloudflare R2 / S3-compatible settings for pgBackRest (used via environment)
# Replace with your values before running stanza-create/check
PGBACKREST_REPO1_S3_BUCKET=your-bucket-name
PGBACKREST_REPO1_S3_ENDPOINT=YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_KEY=your-access-key-id
PGBACKREST_REPO1_S3_KEY_SECRET=your-secret-access-key
PGBACKREST_REPO1_S3_REGION=auto
# path style is defaulted via config; override with 'host' if needed
# PGBACKREST_REPO1_S3_URI_STYLE=path

