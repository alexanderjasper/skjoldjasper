# Pin a specific release; don't track a floating tag.
# Tags: https://hub.docker.com/r/gerbera/gerbera/tags
GERBERA_VERSION=3.2.1

# Must match UPLOAD_LOCATION in infra/immich/.env — same library, mounted read-only.
IMMICH_UPLOAD_LOCATION=/home/alexander/Immich/library

TZ=Europe/Copenhagen

# Only if you have chowned the Immich library away from root.
# GERBERA_USER=1000:1000
