# Pin a specific release; don't track a floating tag.
# v0.2.0 targets the Immich v3 album API — it does not work against Immich v2.
# Tags: https://github.com/SemaiCZE/immich-dlna/tags
IMMICH_DLNA_VERSION=v0.2.0

# Immich's own port 2283 is unpublished (all traffic enters via Traefik, matched
# on Host), so a host-networked container cannot reach it by name. Requires the
# loopback publish on the immich stack — see this dir's README.
IMMICH_URL=http://127.0.0.1:2283/api

# Immich → Account Settings → API Keys. Read-only is enough.
# Set the real value in the Dokploy UI; never commit it.
IMMICH_API_TOKEN=

# Any stable UUID; `uuidgen`. Must not change between restarts.
IMMICH_DLNA_SERVER_UUID=aa7dca8a-f9f3-4e31-ba38-5a2d8746589c

IMMICH_DLNA_FRIENDLY_NAME=Immich
IMMICH_DLNA_HTTP_PORT=8200

# The host's LAN IP, not a hostname and not 127.0.0.1 — this is the address TVs
# are told to fetch from. Must match IMMICH_DLNA_HTTP_PORT.
IMMICH_DLNA_BASE_URL=http://192.168.0.245:8200
IMMICH_DLNA_LOG_LEVEL=INFO
TZ=Europe/Copenhagen
