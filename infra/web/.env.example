# Django
SECRET_KEY=generate-with-`python -c 'import secrets; print(secrets.token_urlsafe(60))'`
ALLOWED_HOSTS=skjoldjasper.dk
CSRF_TRUSTED_ORIGINS=https://skjoldjasper.dk

# Litestream / rclone-as-S3 shared secret. Any random string; both sides must match.
LITESTREAM_SECRET=generate-with-`python -c 'import secrets; print(secrets.token_urlsafe(32))'`

# pCloud OAuth token (used by rclone's native pcloud backend).
# Generate on your Mac with:
#   docker run --rm -it -p 53682:53682 rclone/rclone authorize "pcloud"
# Copy the JSON blob printed at the end (everything between the curly braces).
#
# HOSTNAME — api.pcloud.com (US region) or eapi.pcloud.com (EU region).
RCLONE_PCLOUD_HOSTNAME=api.pcloud.com
RCLONE_PCLOUD_TOKEN={"access_token":"...","token_type":"bearer","refresh_token":"...","expiry":"..."}
