# Django
SECRET_KEY=generate-with-`python -c 'import secrets; print(secrets.token_urlsafe(60))'`
ALLOWED_HOSTS=skjoldjasper.dk
CSRF_TRUSTED_ORIGINS=https://skjoldjasper.dk

# Litestream / rclone-as-S3 shared secret. Any random string; both sides must match.
LITESTREAM_SECRET=generate-with-`python -c 'import secrets; print(secrets.token_urlsafe(32))'`

# pCloud WebDAV credentials.
#   USER  — your pCloud login (email).
#   PASS  — generate at https://my.pcloud.com → Settings → WebDAV (app password),
#           then obscure for rclone with `rclone obscure <password>`.
RCLONE_PCLOUD_USER=
RCLONE_PCLOUD_PASS_OBSCURED=
